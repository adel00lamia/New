{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "cdg1"
  ],
  "functions": {
    "api/ai.js": {
      "maxDuration": 300
    },
    "api/paie-lire.js": {
      "maxDuration": 60
    },
    "api/plf-analyse.js": {
      "maxDuration": 60
    },
    "api/plf-chat.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/simulateur-bp-plf2027",
      "destination": "/simulateur-lf2027.html"
    }
  ]
}